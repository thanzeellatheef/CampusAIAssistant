NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_admin
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DOCUMENT_STORAGE_DIR=./storage/course-documents

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=replace-with-at-least-8-characters
DEMO_PASSWORD=replace-with-at-least-8-characters
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55
RAG_MAX_PDF_BYTES=8388608
RAG_MAX_PDF_PAGES=40
RAG_CHUNK_CHARS=1000
RAG_CHUNK_OVERLAP=150

CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
BCRYPT_ROUNDS=12
