const path = require('path');
const migrationDirectory = process.env.NODE_ENV === 'production' ? 'dist' : 'src';

module.exports = {
  config: path.resolve('sequelize.config.js'),
  'migrations-path': path.resolve(migrationDirectory, 'migrations'),
  'seeders-path': path.resolve(migrationDirectory, 'seeders'),
  'models-path': path.resolve(migrationDirectory, 'models'),
};
